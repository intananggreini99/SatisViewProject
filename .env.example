# ============================================================================
# SatisView — salin menjadi .env lalu sesuaikan:   cp .env.example .env
# ============================================================================

# ---------- Sumber data ------------------------------------------------------
# Dashboard hanya memakai respons ASLI dari Google Form, yang tersimpan sebagai
# Google Sheets di folder Google Drive "Data Responden" (tidak ada data contoh).
# Folder Google Drive "Data Responden" dan folder dokumen laporan
GDRIVE_DATA_FOLDER_ID=1eGAoqvFkWy0qmNz_hFyMgY8kzQaGntJ7
GDRIVE_REPORT_FOLDER_ID=1USXnj85DRgiZ84qoBUAIWAhg7M6VS6RG
SATISVIEW_REPORT_FILENAME=SatisView_Report.pdf

# Akses Google Drive (pilih salah satu; lihat README):
#  1) Service account: simpan JSON di ./secrets/service-account.json (otomatis terdeteksi)
#  2) API key Google Drive API v3 (folder harus "Siapa saja yang memiliki link"):
GDRIVE_API_KEY=
#  3) Kosongkan keduanya = mode publik (gdown), folder harus "Siapa saja yang memiliki link"

# Jadwal pipeline (cron, zona waktu WIB). "none" = hanya manual dari Airflow UI.
SATISVIEW_SCHEDULE=0 */6 * * *

# Modul preprocessing & analisis. Default = kode tim dari Preprocessing&Analysis.zip
# (airflow/include/satisview/tim/). Ganti hanya bila memakai modul lain (lihat README).
SATISVIEW_PREPROCESSING_MODULE=satisview.preprocessing
SATISVIEW_ANALYSIS_MODULE=satisview.analysis
# Minimal responden (yang menjawab semua aspek) agar peta MDS suatu segmen dihitung
SATISVIEW_MIN_RESPONDEN_MDS=10
# Validasi preprocessing gagal bila jawaban Likert yang tidak terkonversi > 1%
SATISVIEW_MAX_GAGAL_KONVERSI=0.01

# ---------- PostgreSQL (data warehouse) --------------------------------------
POSTGRES_USER=satisview
POSTGRES_PASSWORD=satisview_ganti_password
POSTGRES_DB=satisview
POSTGRES_HOST_PORT=5433
# Pengguna baca-saja untuk API dashboard
DASHBOARD_DB_USER=dashboard_reader
DASHBOARD_DB_PASSWORD=dashboard_ganti_password

# ---------- Apache Airflow ---------------------------------------------------
# Linux: isi dengan hasil perintah `id -u` agar file log tidak dimiliki root.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_ganti_password
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_SECRET_KEY=ganti-dengan-string-acak-panjang
# Opsional: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# ---------- Port di komputer host --------------------------------------------
DASHBOARD_PORT=3000
AIRFLOW_PORT=8080
HDFS_UI_PORT=9870
